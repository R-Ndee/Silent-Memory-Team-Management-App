rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Users collection rules
    match /users/{userId} {
      // Authenticated users can read their own user profile document.
      // Admin and Super Admin can read all user profile documents.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isRole('admin') ||
        isRole('super_admin')
      );

      // Account creation and updates restricted per business rules
      allow create, update: if isAuthenticated() && isRole('super_admin');

      // Permanent deletion of user accounts is disallowed to protect historical data integrity
      allow delete: if false;
    }
  }
}
